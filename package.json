{
  "name": "dsh-runtime-nutrition-label",
  "version": "0.1.0",
  "description": "Evidence-backed runtime nutrition labels for DeepSeek Harness plugins and tool namespaces",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "cordis",
    "agent",
    "observability",
    "security",
    "plugin"
  ],
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biubiukam/dsh-runtime-nutrition-label.git"
  },
  "bugs": {
    "url": "https://github.com/biubiukam/dsh-runtime-nutrition-label/issues"
  },
  "homepage": "https://github.com/biubiukam/dsh-runtime-nutrition-label#readme",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./command": {
      "types": "./lib/types/command.d.ts",
      "default": "./lib/command.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "runtimePeers": {
      "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.2.0",
      "@deepseek-ai/dsh-fs": ">=0.0.1-rc.1 <0.2.0",
      "@deepseek-ai/dsh-commands": ">=0.0.1-rc.1 <0.2.0",
      "@deepseek-ai/dsh-invariants": ">=0.0.1-rc.1 <0.2.0"
    }
  },
  "scripts": {
    "build": "pnpm clean && tsdown && tsc -p tsconfig.build.json",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm hygiene",
    "clean": "node scripts/clean.mjs",
    "hygiene": "publint && knip",
    "lint": "oxlint --type-aware --type-check --report-unused-disable-directives-severity=error --config .oxlintrc.json .",
    "lint:fix": "oxlint --type-aware --type-check --report-unused-disable-directives-severity=error --config .oxlintrc.json --fix .",
    "prepack": "pnpm check",
    "prepare": "pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.1.8",
    "knip": "^6.16.1",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "publint": "^0.3.21",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "yaml": "^2.9.0"
  }
}
